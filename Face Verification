pragma solidity ^0.8.20;

contract ContentVerifier {

    struct Record {
        bytes32 contentHash;
        uint256 timestamp;
        address uploader;
    }

    mapping(bytes32 => Record) public records;

    function storeHash(bytes32 _hash) public {
        records[_hash] = Record(
            _hash,
            block.timestamp,
            msg.sender
        );
    }

    function verifyHash(bytes32 _hash)
        public
        view
        returns (bool)
    {
        return records[_hash].contentHash == _hash;
    }
